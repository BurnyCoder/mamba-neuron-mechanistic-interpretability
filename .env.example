# Copy to `.env` and edit. Every key is read by src/mamba_neurons/config.py (python-dotenv,
# https://github.com/theskumar/python-dotenv). `.env` is gitignored, so secrets never reach GitHub.

# --- Models (HF ids, https://huggingface.co/state-spaces) ---
MODEL_NAME=state-spaces/mamba-1.4b-hf
TEST_MODEL_NAME=state-spaces/mamba-130m-hf
DTYPE=bfloat16
DEVICE=cuda
# true = mamba.py parallel scan (needs `mambapy`), false = HF sequential scan
USE_MAMBAPY=false

# --- Data (Pile sample, https://huggingface.co/datasets/NeelNanda/pile-10k) ---
DATASET_NAME=NeelNanda/pile-10k
HELDOUT_FRACTION=0.3
CTX_LEN=128
MAX_WINDOWS_PER_DOC=4
MAX_DISCOVERY_TOKENS=3000000
MAX_HELDOUT_TOKENS=1300000
BATCH_SIZE=16

# --- Neuron statistics ---
TOP_K=20
N_RANDOM_DIRECTIONS_PER_LAYER=2
SEED=0

# --- Local LLM for labels / judging (https://ollama.com/library/qwen3.5) ---
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen3.5:4b

# --- Paths (big caches on D: to spare C:) ---
OUTPUT_DIR=D:/AI/mamba-neurons/outputs
HF_HOME=D:/AI/hf_cache
# Windows without Developer Mode has no symlinks; the HF cache still works (https://huggingface.co/docs/huggingface_hub/how-to-cache#limitations)
HF_HUB_DISABLE_SYMLINKS_WARNING=1
# Moving HF_HOME also moves the default token location; point back to the `hf auth login` token
# (https://huggingface.co/docs/huggingface_hub/package_reference/environment_variables#hftokenpath)
HF_TOKEN_PATH=C:/Users/Happy/.cache/huggingface/token
RESULTS_DIR=results
LOG_DIR=logs

# --- Publishing ---
HF_DATASET_REPO=BurnyCoder/mamba-1.4b-neuron-atlas
